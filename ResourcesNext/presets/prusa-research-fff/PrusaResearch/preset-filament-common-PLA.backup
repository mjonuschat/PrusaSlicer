    name: '*PLA* @MINI 0.6'
    values:
      filament_max_volumetric_speed: 15
      slowdown_below_layer_time: 18
      pressure_advance: 0.17
  # MINI 0.8
  - condition: tool.nozzle_diameter == 0.8
    name: '*PLA* @MINI 0.8'
